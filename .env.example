# Path to the Google service-account JSON key file with GA4 Data API viewer access.
# Create this via the GCP console; do NOT commit the actual JSON.
# Example: ~/.config/s360-ga4-toolkit/service-account.json
GA4_SERVICE_ACCOUNT_PATH=

# Default lookback window for queries that use relative date shortcuts (e.g., `--last 30d`).
GA4_DEFAULT_LOOKBACK_DAYS=30

# Log level for CLI and MCP server output. One of: DEBUG, INFO, WARNING, ERROR.
GA4_LOG_LEVEL=INFO

# Path to the sites.yaml file. Defaults to ./config/sites.yaml relative to the repo root.
# Override if you keep your sites config elsewhere (e.g., a shared team config outside the repo).
# GA4_SITES_CONFIG=

# --- Docker-compose only ---
# Absolute path on the host to the service-account JSON. docker-compose mounts
# this into the container at /app/secrets/service-account.json. Ignored when
# running the CLI natively with `uv run` or `pip install`.
# Example: /Users/george/.config/s360-ga4-toolkit/service-account.json
GA4_SERVICE_ACCOUNT_PATH_HOST=

# Optional: override the sites.yaml location when running via docker-compose.
# Defaults to ./config/sites.yaml relative to the compose file.
# GA4_SITES_CONFIG_HOST=
